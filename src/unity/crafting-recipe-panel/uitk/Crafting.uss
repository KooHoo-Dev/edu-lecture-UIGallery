/* 제작 패널 (UI Toolkit). 1920×1080. USS 에 gradient · box-shadow 가 없어 단색 + 테두리로 그린다 */
.craft-root {
    flex-grow: 1;
    padding: 28px 48px;
    background-color: rgb(9, 12, 18);
    color: rgb(238, 242, 247);
    font-size: 24px;
}
.head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 110px;
}
.title {
    font-size: 50px;
    -unity-font-style: bold;
}
.stock {
    flex-direction: row;
}
.stock > Label {
    margin-left: 12px;
    padding: 10px 18px;
    border-radius: 14px;
    border-width: 2px;
    border-color: rgba(170, 200, 240, 0.16);
    background-color: rgb(16, 22, 32);
    font-size: 26px;
}
.body {
    flex-direction: row;
    flex-grow: 1;
}
.panel {
    margin-right: 24px;
    padding: 22px;
    border-radius: 20px;
    border-width: 2px;
    border-color: rgba(170, 200, 240, 0.16);
    background-color: rgb(16, 22, 32);
}
.list-panel {
    width: 700px;
}
.detail {
    width: 650px;
}
.queue-panel {
    flex-grow: 1;
    margin-right: 0;
}

/* 탭 · 검색 · 필터 */
.tabs {
    flex-direction: row;
    height: 66px;
}
.tab {
    flex-grow: 1;
    margin: 0 4px;
    font-size: 26px;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(255, 255, 255, 0.04);
    color: rgb(148, 161, 180);
}
.tab--active {
    border-color: rgb(255, 194, 61);
    background-color: rgba(255, 194, 61, 0.14);
    color: rgb(238, 242, 247);
    -unity-font-style: bold;
}
/* 새 레시피가 든 탭: 오른쪽 굵은 빨간 띠 (색 + 모양) */
.tab--new {
    border-right-width: 8px;
    border-right-color: rgb(232, 71, 90);
}
.tools {
    flex-direction: row;
    margin: 14px 0;
}
.search {
    flex-grow: 1;
    font-size: 24px;
}
.filter {
    margin-left: 12px;
    font-size: 22px;
}
.recipe-list {
    flex-grow: 1;
}

/* 레시피 줄 — 수식 클래스는 C# 가 붙인다 */
.row {
    flex-direction: row;
    align-items: center;
    height: 92px;
    margin-bottom: 8px;
    padding: 0 16px 0 22px;
    border-radius: 14px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-left-width: 8px;
    background-color: rgba(255, 255, 255, 0.03);
}
.row--ok {
    border-left-color: rgb(95, 227, 154);
    background-color: rgba(95, 227, 154, 0.07);
}
.row--selected,
.row:focus {
    border-color: rgb(255, 194, 61);
    background-color: rgba(255, 194, 61, 0.12);
}
.row__name {
    flex-grow: 1;
    font-size: 28px;
    color: rgb(185, 195, 210);
}
.row--ok .row__name {
    color: rgb(238, 242, 247);
}
.row__state {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 157, 157);
}
.row--ok .row__state {
    color: rgb(95, 227, 154);
}
.row__new {
    margin-left: 10px;
    padding: 0 8px;
    border-radius: 8px;
    font-size: 22px;
    -unity-font-style: bold;
    background-color: rgb(232, 71, 90);
    color: rgb(255, 255, 255);
}
.hidden {
    display: none;
}

/* 상세 */
.d-name {
    font-size: 42px;
    -unity-font-style: bold;
}
.d-meta,
.d-sub {
    font-size: 22px;
    color: rgb(148, 161, 180);
}
.d-sub {
    margin-top: 20px;
    margin-bottom: 8px;
}
.ing {
    flex-direction: row;
    align-items: center;
    height: 80px;
    margin-bottom: 10px;
    padding: 0 16px;
    border-radius: 14px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(255, 255, 255, 0.04);
}
.ing--short {
    border-color: rgba(255, 123, 123, 0.55);
    background-color: rgba(255, 123, 123, 0.08);
}
.ing__icon {
    width: 50px;
    height: 50px;
    margin-right: 14px;
    -unity-background-scale-mode: scale-to-fit;
}
.ing__name {
    flex-grow: 1;
    font-size: 26px;
}
.ing__count {
    width: 110px;
    -unity-text-align: middle-right;
    font-size: 30px;
}
.ing__tag {
    width: 150px;
    margin-left: 14px;
    font-size: 22px;
    color: rgb(95, 227, 154);
}
.ing--short .ing__count,
.ing--short .ing__tag {
    color: rgb(255, 123, 123);
    -unity-font-style: bold;
}
.spacer {
    flex-grow: 1;
}
.craft {
    height: 92px;
    font-size: 34px;
    -unity-font-style: bold;
    border-radius: 16px;
    background-color: rgb(255, 194, 61);
    color: rgb(42, 29, 0);
}
.craft:disabled {
    background-color: rgb(38, 49, 66);
    color: rgb(183, 194, 208);
}
.reason {
    margin-top: 12px;
    font-size: 24px;
    color: rgb(255, 123, 123);
}
.reason--ok {
    color: rgb(95, 227, 154);
}

/* 대기열 */
.q-title {
    font-size: 28px;
    margin-bottom: 14px;
}
.job {
    flex-direction: row;
    align-items: center;
    height: 96px;
    margin-bottom: 10px;
    padding: 0 12px 0 14px;
    border-radius: 14px;
    border-width: 2px;
    border-color: rgba(170, 200, 240, 0.16);
    background-color: rgba(255, 255, 255, 0.05);
}
.job--empty {
    justify-content: center;
    color: rgb(93, 106, 125);
    font-size: 22px;
}
.job__text {
    flex-grow: 1;
}
.job__bar {
    height: 12px;
    margin-top: 10px;
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.1);
    overflow: hidden;
}
.job__fill {
    width: 0;
    height: 100%;
    background-color: rgb(102, 224, 255);
}
.job__time {
    width: 80px;
    -unity-text-align: middle-right;
    font-size: 26px;
}
.job__cancel {
    width: 52px;
    height: 52px;
    margin-left: 10px;
    border-radius: 12px;
    font-size: 26px;
    background-color: rgba(255, 123, 123, 0.12);
    color: rgb(255, 176, 176);
}
