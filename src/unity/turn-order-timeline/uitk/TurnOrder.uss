/* 턴 순서 타임라인 — Panel Settings: Scale With Screen Size, Reference Resolution 1920×1080.
   한글이 네모로 보이면 Panel Settings 의 Text Settings 에 한글 글꼴(Font Asset)을 넣는다.
   칸 위치(translate · scale)는 C# 가 매 프레임 보간한다 — 칸에 transition 을 걸지 않는다. */

.battle {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.timeline {
    position: absolute;
    border-radius: 18px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(7, 13, 21, 0.85);
}

.timeline--left {
    left: 24px;
    top: 24px;
    width: 380px;
    height: 1032px;
}

.timeline--top {
    left: 24px;
    top: 20px;
    width: 1872px;
    height: 222px;
}

.axis {
    position: absolute;
    display: none;
    border-color: rgba(255, 255, 255, 0.25);
}

.timeline--left .axis {
    left: 10px;
    top: 172px;
    bottom: 12px;
    border-left-width: 3px;
}

.timeline--top .axis {
    left: 214px;
    right: 12px;
    top: 192px;
    height: 0;
    border-top-width: 3px;
}

.timeline--time .axis {
    display: flex;
}

/* ───── 칸 ───── */
.portrait {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: left top;
}

.timeline--left .portrait {
    flex-direction: row;
    align-items: center;
    width: 260px;
    height: 72px;
}

.timeline--top .portrait {
    flex-direction: column;
    align-items: center;
    width: 120px;
    height: 148px;
}

.portrait__frame {
    width: 68px;
    height: 68px;
    border-width: 5px;
    align-items: center;
    justify-content: center;
}

.timeline--top .portrait__frame {
    width: 88px;
    height: 88px;
}

/* 아군: 둥근 사각 틀 + 캡슐 · 적: 각진 틀 + 삼각 — 색만으로 구분하지 않는다 */
.portrait--ally .portrait__frame {
    border-radius: 20px;
    border-color: rgb(90, 209, 255);
    background-color: rgb(16, 32, 46);
}

.portrait--enemy .portrait__frame {
    border-radius: 2px;
    border-color: rgb(255, 106, 92);
    background-color: rgb(42, 18, 22);
}

.portrait--ally .portrait__body {
    width: 24px;
    height: 48px;
    border-radius: 12px;
    background-color: rgb(90, 209, 255);
}

/* 테두리 삼각형: 크기 0 + 아래 테두리만 색 */
.portrait--enemy .portrait__body {
    width: 0;
    height: 0;
    border-left-width: 22px;
    border-right-width: 22px;
    border-bottom-width: 40px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgb(255, 106, 92);
}

.portrait--active .portrait__frame {
    border-color: rgb(255, 207, 90);
}

.portrait--extra .portrait__frame {
    border-color: rgb(197, 155, 255);
}

.portrait__bolt {
    position: absolute;
    left: -14px;
    top: -14px;
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background-color: rgb(197, 155, 255);
    display: none;
}

.portrait--extra .portrait__bolt {
    display: flex;
}

.timeline--left .portrait__info {
    margin-left: 14px;
}

.timeline--top .portrait__info {
    align-items: center;
}

.portrait__name {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(211, 242, 255);
    padding: 0;
    margin: 0;
}

.portrait--enemy .portrait__name {
    color: rgb(255, 208, 201);
}

.portrait__value {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    padding: 0;
    margin: 0;
}

.portrait--active .portrait__value {
    color: rgb(16, 20, 28);
    background-color: rgb(255, 207, 90);
    border-radius: 8px;
    padding: 0 8px;
}

.portrait--extra .portrait__value {
    color: rgb(16, 20, 28);
    background-color: rgb(197, 155, 255);
    border-radius: 8px;
    padding: 0 8px;
}

.portrait__badge {
    position: absolute;
    display: none;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(16, 20, 28);
    border-radius: 10px;
    padding: 0 8px;
}

.portrait__badge--on {
    display: flex;
}

.timeline--left .portrait__badge {
    right: -6px;
    top: 20px;
}

.timeline--top .portrait__badge {
    right: -14px;
    top: -14px;
}

/* ───── 이유 한 줄 ───── */
.caption {
    position: absolute;
    left: 450px;
    top: 40px;
    font-size: 26px;
    color: rgb(234, 242, 251);
    padding: 10px 22px;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(255, 207, 90);
    background-color: rgba(11, 19, 29, 0.9);
    opacity: 0;
}

.caption--top {
    left: 480px;
    top: 262px;
}

.caption--on {
    opacity: 1;
}
