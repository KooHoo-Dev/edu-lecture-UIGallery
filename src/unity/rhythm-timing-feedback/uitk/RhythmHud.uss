/* 박자 표시 · 판정 피드백 (UI Toolkit). Panel Settings: Scale With Screen Size 1920×1080.
   노트 · 판정 문구 위치는 C# 가 style.translate 로 매 프레임 넣는다 — USS transition 으로 노트를 움직이지 않는다. */
.rhythm {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: rgb(238, 242, 248);
    font-size: 24px;
}

.lamp {
    position: absolute;
    top: 24px;
    left: 760px;
    width: 400px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}
.lamp__title {
    color: rgb(154, 166, 184);
    margin-right: 10px;
}
.lamp__beat {
    width: 46px;
    height: 46px;
    margin: 0 7px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.45);
    border-radius: 8px;
}
.lamp__beat--down {
    border-radius: 23px;
}
.lamp__beat--on {
    background-color: rgb(255, 215, 94);
    border-color: rgb(255, 215, 94);
    color: rgb(26, 20, 4);
}

.highway {
    position: absolute;
    top: 100px;
    height: 840px;
    left: 660px;
    width: 600px;
    background-color: rgba(6, 10, 20, 0.86);
    border-left-width: 3px;
    border-right-width: 3px;
    border-color: rgba(255, 255, 255, 0.28);
    overflow: hidden;
}
.highway__lanes,
.highway__notes {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}
.highway__lanes {
    flex-direction: row;
}
.lane {
    width: 150px;
    border-left-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
}
.note {
    position: absolute;
    left: 0;
    top: 0;
    width: 130px;
    height: 30px;
    border-radius: 8px;
    background-color: rgb(238, 244, 255);
}
.note--inner {
    background-color: rgb(95, 211, 255);
}
.note--miss {
    opacity: 0.32;
}

/* 판정선은 highway 안 위에서 700px (= 노트가 지나는 거리 680 + 위 여백 20) */
.judge-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 697px;
    height: 6px;
    background-color: rgb(255, 255, 255);
}
.band {
    position: absolute;
    left: 0;
    right: 0;
    top: 700px;
    height: 0;
}
.band__w {
    position: absolute;
    left: 0;
    right: 0;
    border-top-width: 2px;
    border-bottom-width: 2px;
}
.band__good {
    background-color: rgba(123, 227, 138, 0.13);
    border-color: rgba(123, 227, 138, 0.6);
}
.band__great {
    background-color: rgba(95, 211, 255, 0.16);
    border-color: rgba(95, 211, 255, 0.7);
}
.band__perfect {
    background-color: rgba(255, 215, 94, 0.26);
    border-color: rgba(255, 215, 94, 0.85);
}

.feedback {
    position: absolute;
    left: 660px;
    top: 330px;
    width: 600px;
    align-items: center;
}
.feedback__word {
    font-size: 76px;
    -unity-font-style: bold;
    min-height: 84px;
}
.feedback__timing {
    font-size: 32px;
    -unity-font-style: bold;
    visibility: hidden;
}
.feedback__timing--on {
    visibility: visible;
}
.feedback__early {
    color: rgb(130, 180, 255);
}
.feedback__late {
    color: rgb(255, 162, 79);
}
.feedback__combo {
    font-size: 30px;
    -unity-text-align: middle-center;
    color: rgb(154, 166, 184);
}

.meter {
    position: absolute;
    left: 660px;
    top: 952px;
    width: 600px;
    height: 44px;
}
.meter__good,
.meter__great,
.meter__perfect {
    position: absolute;
    top: 15px;
    height: 14px;
    border-radius: 7px;
}
.meter__good {
    left: 20px;
    right: 20px;
    background-color: rgba(123, 227, 138, 0.45);
}
.meter__great {
    left: 113px;
    right: 113px;
    background-color: rgba(95, 211, 255, 0.6);
}
.meter__perfect {
    left: 207px;
    right: 207px;
    background-color: rgba(255, 215, 94, 0.85);
}
.meter__ticks {
    position: absolute;
    left: 300px;
    top: 4px;
    width: 0;
    height: 36px;
}
.tick {
    position: absolute;
    left: -2px;
    top: 0;
    width: 4px;
    height: 36px;
    border-radius: 2px;
    background-color: rgb(255, 255, 255);
}

.panel {
    position: absolute;
    top: 560px;
    width: 560px;
    padding: 20px 24px;
    background-color: rgba(10, 15, 27, 0.88);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 14px;
}
.panel--left {
    left: 40px;
}
.panel--right {
    right: 40px;
    top: 40px;
}
.panel__title {
    font-size: 28px;
    -unity-font-style: bold;
}
.panel__big {
    font-size: 36px;
    color: rgb(255, 215, 94);
    margin: 6px 0;
}
.panel__text {
    white-space: normal;
    margin: 8px 0;
}
.panel__row {
    flex-direction: row;
}
.ruler {
    height: 60px;
    margin: 8px 10px;
    border-bottom-width: 2px;
    border-color: rgba(255, 255, 255, 0.35);
}
.ruler__tick {
    position: absolute;
    top: 10px;
    width: 4px;
    height: 34px;
    background-color: rgb(255, 162, 79);
}
.btn {
    font-size: 24px;
    padding: 8px 16px;
    margin-right: 12px;
    border-radius: 10px;
}
.btn--primary {
    background-color: rgb(255, 215, 94);
    color: rgb(26, 20, 4);
}
.life {
    height: 24px;
    margin-top: 12px;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.3);
    overflow: hidden;
}
.life__fill {
    height: 100%;
    background-color: rgb(123, 227, 138);
    transform-origin: left;
}
