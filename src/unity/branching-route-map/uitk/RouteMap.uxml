<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="RouteMap.uss" />
    <!-- 분기 경로 맵 (세로 1080×1920). 노드 · 간선 · 범례 버튼은 C# 가 데이터에서 만든다 -->
    <ui:VisualElement name="screen" class="screen">
        <ui:VisualElement class="head">
            <ui:Label class="head__title" text="외곽 탐사대 · 3구역 귀환 경로" />
            <ui:Label name="here" class="head__here" text="출발 전" />
        </ui:VisualElement>
        <ui:ScrollView name="map" class="map" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
            <!-- content 높이는 C# 가 층 수로 정한다. 첫 자식은 간선 레이어(EdgeLayer), 그 위에 노드 Button -->
            <ui:VisualElement name="content" class="map__content" />
        </ui:ScrollView>
        <ui:VisualElement name="legend" class="legend" />
        <ui:VisualElement class="save">
            <ui:Label name="seed" class="save__seed" text="시드" />
            <ui:Label name="json" class="save__json" text="" />
            <ui:VisualElement class="save__buttons">
                <ui:Button name="btn-save" class="save__btn" text="저장" />
                <ui:Button name="btn-load" class="save__btn" text="불러오기" />
                <ui:Button name="btn-new" class="save__btn" text="새 지도" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
