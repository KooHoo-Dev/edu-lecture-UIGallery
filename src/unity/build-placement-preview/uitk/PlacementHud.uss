/* 건설 배치 HUD — Panel Settings: Scale With Screen Size 1920×1080 */
.hud {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    -unity-font-style: bold;
    color: rgb(234, 242, 251);
    font-size: 24px;
}
.top {
    position: absolute;
    left: 32px; right: 32px; top: 22px;
    height: 70px;
    flex-direction: row;
    align-items: center;
}
.credits {
    flex-direction: row;
    align-items: center;
    padding: 6px 20px;
    border-radius: 14px;
    background-color: rgb(13, 24, 36);
}
.credits__value { font-size: 36px; color: rgb(255, 209, 102); margin-right: 8px; }
.hint { flex-grow: 1; -unity-text-align: middle-center; color: rgb(201, 214, 226); }

.palette { position: absolute; left: 1600px; top: 150px; width: 290px; }
.item {
    height: 150px;
    margin: 0 0 18px 0;
    padding: 12px 16px;
    border-radius: 16px;
    border-width: 3px;
    border-color: rgb(47, 70, 89);
    background-color: rgb(20, 33, 49);
    -unity-text-align: upper-left;
}
.item__name { font-size: 26px; }
.item__cost { font-size: 28px; color: rgb(255, 209, 102); }
/* 살 수 없는 건물: 흐리게 + 부족한 양 (버튼은 눌린다 — 누르면 이유를 말한다) */
.item--locked { opacity: 0.55; }
.item--locked .item__cost { color: rgb(255, 90, 106); font-size: 24px; }
.item--selected { border-color: rgb(94, 230, 201); }

/* 사유 문구: left · top 은 C# 가 정하고, 아래 가운데가 그 점에 오도록 옮긴다 */
.reason {
    position: absolute;
    translate: -50% -100%;
    flex-direction: row;
    align-items: center;
    padding: 8px 18px 8px 10px;
    border-radius: 14px;
    border-width: 3px;
    border-color: rgb(74, 222, 128);
    background-color: rgba(6, 24, 15, 0.94);
}
/* USS 에는 점선 테두리가 없다 — 모양 신호는 사유 아이콘과 글자가 맡는다 */
.reason--bad {
    border-color: rgb(255, 90, 106);
    background-color: rgba(26, 7, 11, 0.94);
}
.reason--below { translate: -50% 0; }
.reason__icon { width: 40px; height: 40px; margin-right: 12px; -unity-background-image-tint-color: rgb(255, 255, 255); }
.reason__text { font-size: 26px; white-space: nowrap; }

.confirm { position: absolute; translate: 0 -50%; }
.confirm--left { translate: -100% -50%; }
.confirm__ok, .confirm__no {
    width: 170px; height: 76px;
    margin: 0 0 12px 0;
    font-size: 26px;
    border-radius: 16px;
    border-width: 3px;
}
.confirm__ok { background-color: rgb(22, 107, 58); border-color: rgb(74, 222, 128); color: rgb(255, 255, 255); }
.confirm__ok:disabled { background-color: rgb(42, 50, 64); border-color: rgb(107, 118, 134); color: rgb(154, 167, 182); }
.confirm__no { background-color: rgb(58, 29, 35); border-color: rgb(255, 138, 150); }

.note {
    position: absolute;
    left: 960px; bottom: 22px;
    translate: -50% 0;
    padding: 10px 22px;
    border-radius: 14px;
    background-color: rgba(5, 10, 16, 0.92);
    border-width: 2px;
    border-color: rgb(255, 90, 106);
    color: rgb(255, 194, 200);
}
.is-hidden { display: none; }
