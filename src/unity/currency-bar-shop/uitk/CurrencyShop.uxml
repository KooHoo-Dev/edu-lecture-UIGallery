<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- 재화 바 · 상점 · 구매 확인 (UI Toolkit 판). 공용 UIDocument 하나에 두고 DontDestroyOnLoad 로 남긴다.
         상점이 아닌 씬에서는 #shop 만 숨기고 바는 그대로. 진열 카드와 날아가는 아이콘은 CurrencyShopUITK.cs 가 만든다 -->
    <Style src="CurrencyShop.uss" />
    <ui:VisualElement name="app" class="app" picking-mode="Ignore">
        <ui:VisualElement name="shop" class="shop">
            <ui:Label class="strip" text="모의 상점 · 실제 결제 없음 · 결정 1개 ≈ ₩20 (기본 충전 기준)" />
            <ui:VisualElement class="shop__cols">
                <ui:VisualElement class="shop__col">
                    <ui:Label class="shop__title" text="묶음 상품" />
                    <ui:VisualElement name="bundles" class="bundles" />
                </ui:VisualElement>
                <ui:VisualElement name="packs-col" class="shop__col shop__col--packs">
                    <ui:Label class="shop__title" text="궤도 결정 충전" />
                    <ui:VisualElement name="packs" class="packs" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 확인 창: confirm 에 수식 클래스 open 을 붙이면 보인다. 바보다 먼저 두어 바가 위에 그려진다 -->
        <ui:VisualElement name="confirm" class="confirm" picking-mode="Ignore">
            <ui:VisualElement name="dim" class="confirm__dim" />
            <ui:VisualElement name="window" class="confirm__window">
                <ui:VisualElement class="confirm__head">
                    <ui:VisualElement name="window-icon" class="confirm__icon" />
                    <ui:VisualElement>
                        <ui:Label name="title" class="confirm__title" />
                        <ui:Label name="contents" class="confirm__contents" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="rows">
                    <ui:VisualElement class="row">
                        <ui:Label class="row__key" text="가격" />
                        <ui:Label name="price" class="row__value" />
                    </ui:VisualElement>
                    <ui:VisualElement name="after-row" class="row">
                        <ui:Label class="row__key" text="구매 후" />
                        <ui:Label name="after" class="row__value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row">
                        <ui:Label class="row__key" text="청약철회" />
                        <ui:Label name="refund" class="row__value" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="short" class="short" />
                <ui:VisualElement class="actions">
                    <ui:Button name="cancel" class="btn btn--cancel" text="취소" />
                    <ui:VisualElement class="buy-wrap">
                        <ui:Button name="buy" class="btn btn--buy" text="구매" />
                        <ui:VisualElement class="lock" picking-mode="Ignore">
                            <ui:VisualElement name="lock-fill" class="lock__fill" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 재화 바: 숫자 Label 은 C# 에서 데이터 바인딩 (WalletSource 의 CreditText · GemText · EnergyText) -->
        <ui:VisualElement name="currency-bar" class="bar">
            <ui:Label class="bar__title" text="외곽 탐사대 보급 상점" />
            <ui:VisualElement name="slot-credit" class="slot">
                <ui:VisualElement name="icon-credit" class="slot__icon slot__icon--credit" />
                <ui:Label name="amount-credit" class="slot__amount" />
                <ui:Label name="gain-credit" class="slot__gain" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="slot-gem" class="slot">
                <ui:VisualElement name="icon-gem" class="slot__icon slot__icon--gem" />
                <ui:Label name="amount-gem" class="slot__amount" />
                <ui:Button name="plus-gem" class="slot__plus" text="+" />
                <ui:Label name="gain-gem" class="slot__gain" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="slot-energy" class="slot">
                <ui:VisualElement name="icon-energy" class="slot__icon slot__icon--energy" />
                <ui:Label name="amount-energy" class="slot__amount" />
                <ui:Button name="plus-energy" class="slot__plus" text="+" />
                <ui:Label name="gain-energy" class="slot__gain" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="fly-layer" class="fly-layer" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
