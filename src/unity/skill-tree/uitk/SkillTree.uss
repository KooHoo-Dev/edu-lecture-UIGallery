/* 스킬트리 — Panel Settings: Scale With Screen Size 1920×1080. 상태는 테두리 두께 · 둥근 정도 · 고리 · 표식 · 글자로 구분한다. */

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 30px 40px;
    background-color: rgb(12, 23, 36);
    color: rgb(234, 242, 251);
}

.title {
    font-size: 36px;
    -unity-font-style: bold;
    margin-bottom: 16px;
}

.body {
    flex-grow: 1;
    flex-direction: row;
}

.viewport {
    flex-grow: 1;
    overflow: hidden;
    border-width: 2px;
    border-color: rgb(47, 74, 102);
    border-radius: 24px;
    background-color: rgba(8, 17, 27, 0.8);
}

/* 확대 기준 왼쪽 위 (기본값 가운데면 휠 기준점이 어긋난다) */
.world {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
}

.branch-core { --bc: rgb(232, 238, 245); }
.branch-harin { --bc: rgb(94, 230, 201); }
.branch-sera { --bc: rgb(143, 184, 255); }
.branch-doyun { --bc: rgb(255, 179, 92); }

/* 노드 — 위치 · 크기는 C# 가 */
.node {
    position: absolute;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    overflow: visible;
}

.node__shape {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    border-radius: 48px;
    border-width: 3px;
    border-color: rgb(106, 127, 149);
    background-color: rgb(15, 27, 40);
}

.node__icon {
    width: 50%;
    height: 50%;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(106, 127, 149);
}

/* 잠김(기본): 얇은 흐린 원 · 습득 가능: 굵은 고리 · 습득: 채운 원 · 최대: 둥근 사각 + 바깥 테두리 */
.node--available .node__shape {
    border-width: 7px;
    border-color: var(--bc);
    background-color: rgb(20, 40, 52);
}

.node--available .node__icon {
    -unity-background-image-tint-color: var(--bc);
}

.node--acquired .node__shape {
    border-color: rgb(255, 255, 255);
    background-color: var(--bc);
}

.node--maxed .node__shape {
    border-radius: 14px;
    border-width: 4px;
    border-color: rgb(11, 22, 34);
    background-color: var(--bc);
}

.node--acquired .node__icon,
.node--maxed .node__icon {
    -unity-background-image-tint-color: rgb(11, 22, 34);
}

.node__ring {
    position: absolute;
    left: -8px;
    top: -8px;
    right: -8px;
    bottom: -8px;
    border-radius: 56px;
    border-width: 3px;
    border-color: rgb(255, 255, 255);
    opacity: 0;
    transition-property: scale, opacity;
    transition-duration: 0.5s, 0.5s;
}

.node--maxed .node__ring {
    opacity: 1;
    border-radius: 20px;
    border-width: 4px;
    border-color: var(--bc);
}

/* 지금 살 수 있는 노드 — world--beat 가 0.5초마다 바뀌어 1Hz */
.node--can .node__ring {
    opacity: 1;
}

.world--beat .node--can .node__ring {
    scale: 1.2 1.2;
    opacity: 0;
}

/* 키보드 · 패드 포커스 */
.node__focus {
    position: absolute;
    left: -16px;
    top: -16px;
    right: -16px;
    bottom: -16px;
    border-radius: 64px;
    border-width: 3px;
    border-color: rgb(255, 255, 255);
    display: none;
}

.node:focus .node__focus {
    display: flex;
}

.node__badge {
    position: absolute;
    right: -12px;
    top: -12px;
    width: 34px;
    height: 34px;
    border-radius: 17px;
    border-width: 2px;
    border-color: var(--bc);
    background-color: rgb(11, 22, 34);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--bc);
    transform-origin: 50% 50%;
}

.node--locked .node__badge {
    border-color: rgb(106, 127, 149);
    -unity-background-image-tint-color: rgb(169, 184, 200);
}

/* 글자 묶음 — C# 가 scale 을 1/배율 로 (기준 위 가운데) */
.node__labels {
    position: absolute;
    left: -52px;
    right: -52px;
    top: 100%;
    margin-top: 8px;
    align-items: center;
    transform-origin: 50% 0;
}

.node__name {
    font-size: 26px;
    -unity-font-style: bold;
    padding: 0 8px;
    border-radius: 8px;
    background-color: rgba(8, 17, 27, 0.88);
}

.node__rank {
    font-size: 24px;
    -unity-font-style: bold;
    padding: 0 10px;
    border-width: 2px;
    border-radius: 14px;
    border-color: var(--bc);
    background-color: rgb(11, 22, 34);
}

.node--locked .node__rank {
    border-color: rgb(106, 127, 149);
    color: rgb(180, 194, 208);
}

.node--maxed .node__rank {
    background-color: var(--bc);
    color: rgb(11, 22, 34);
}

.node__next {
    font-size: 22px;
    color: rgb(207, 224, 240);
    background-color: rgba(8, 17, 27, 0.88);
}

/* 확대 단계: 멀리 아이콘 + 표식 · 중간 + 단계 · 가까이 + 이름 · 수치 */
.lod-far .node__labels {
    display: none;
}

.lod-mid .node__name,
.lod-mid .node__next {
    display: none;
}

.tooltip {
    position: absolute;
    width: 400px;
    padding: 14px 18px;
    border-width: 2px;
    border-radius: 16px;
    border-color: rgb(94, 230, 201);
    background-color: rgba(11, 22, 34, 0.95);
}

.tooltip__title {
    font-size: 28px;
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 6px;
}

.tooltip__body {
    font-size: 24px;
    white-space: normal;
}

.zoombar {
    position: absolute;
    right: 16px;
    top: 16px;
    flex-direction: row;
    align-items: center;
    padding: 10px 16px 10px 10px;
    border-width: 2px;
    border-radius: 16px;
    border-color: rgb(47, 74, 102);
    background-color: rgba(11, 22, 34, 0.9);
}

.zoombar__btn {
    width: 56px;
    height: 56px;
    margin: 0 4px;
    font-size: 32px;
}

.zoombar__value {
    min-width: 90px;
    font-size: 28px;
    -unity-text-align: middle-center;
}

.zoombar__lod {
    margin-left: 8px;
    font-size: 22px;
}

.side {
    width: 470px;
    margin-left: 30px;
}

.side__points {
    margin-bottom: 16px;
    font-size: 28px;
    white-space: normal;
}

.side__btn {
    height: 60px;
    margin: 0 0 10px 0;
    font-size: 24px;
}

.side__toast {
    margin-top: 10px;
    font-size: 24px;
    white-space: normal;
}
