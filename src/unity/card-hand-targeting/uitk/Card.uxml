<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- 카드 한 장 템플릿. 종류는 .card 의 수식 클래스 attack / skill, 못 쓰면 unplayable (이름은 USS 참고) -->
    <ui:VisualElement name="card" class="card" picking-mode="Ignore">
        <ui:Label name="cost" class="card__cost" picking-mode="Ignore" />
        <ui:VisualElement name="aim" class="card__aim" picking-mode="Ignore" />
        <ui:Label name="name" class="card__name" picking-mode="Ignore" />
        <ui:VisualElement name="art" class="card__art" picking-mode="Ignore" />
        <ui:Label name="type" class="card__type" picking-mode="Ignore" />
        <ui:Label name="text" class="card__text" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
